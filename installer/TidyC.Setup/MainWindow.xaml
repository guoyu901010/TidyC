<Window x:Class="TidyC.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TidyC 安装程序"
        Icon="pack://application:,,,/Assets/TidyC.ico"
        Width="680"
        Height="540"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid Margin="30,24,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/TidyC.ico" Width="54" Height="54"
                   VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="16,2,0,0">
                <TextBlock Text="安装 TidyC" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="Windows C 盘扫描、物理占用归因与安全清理 · 版本 2.4.0"
                           FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="安装位置" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" />
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPathBox" Grid.Column="0" Style="{StaticResource FieldTextBox}" />
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Click="Browse_Click" />
            </Grid>
            <TextBlock Text="安装到当前用户目录，无需管理员权限；程序约 161 MB。"
                       FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,8,0,0" />

            <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True" />
            <CheckBox x:Name="LaunchCheck" Content="安装完成后启动 TidyC" IsChecked="True" />

            <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="安装内容" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="TidyC 主程序、.NET 8 运行时组件、开始菜单快捷方式与「卸载 TidyC」入口。卸载时不会删除隔离区与扫描记录。" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <ProgressBar x:Name="InstallProgress" Style="{StaticResource Progress}" Maximum="100" Value="0" />
            <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="11.5"
                       Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="TidyC · MIT License" FontSize="10.5" Foreground="{StaticResource Brush.Text.Secondary}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button x:Name="InstallButton" Content="立即安装" Style="{StaticResource AccentButton}"
                        Click="Install_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
