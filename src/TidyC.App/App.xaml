<Application x:Class="TidyC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TidyC.App.Converters"
             xmlns:vm="clr-namespace:TidyC.App.ViewModels"
             xmlns:views="clr-namespace:TidyC.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/TidyC_AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BytesToTextConverter x:Key="Bytes" />
            <conv:SignedBytesToTextConverter x:Key="SignedBytes" />
            <conv:RatioToPercentConverter x:Key="Percent" />
            <conv:RiskToTextConverter x:Key="RiskText" />
            <conv:RiskToBrushConverter x:Key="RiskBrush" />
            <conv:RiskToPillStyleConverter x:Key="RiskPill" />
            <conv:RiskToSoftBackgroundConverter x:Key="RiskSoft" />
            <conv:CategoryToBrushConverter x:Key="CategoryBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountVisibility" />
            <conv:EmptyStringToVisibilityConverter x:Key="TextVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullVisibility" />
            <conv:ProgressToWidthConverter x:Key="ProgressWidth" />

            <!-- View model → view mapping -->
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TreemapViewModel}">
                <views:TreemapView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}">
                <views:LargeFilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppDataViewModel}">
                <views:AppDataView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanWizardViewModel}">
                <views:CleanWizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
                <views:QuarantineView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScanRecordsViewModel}">
                <views:ScanRecordsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
