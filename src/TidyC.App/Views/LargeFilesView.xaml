<UserControl x:Class="TidyC.App.Views.LargeFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TidyC.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1180"
             Background="Transparent">
    <Grid Margin="30,20,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="大文件与巨石目录" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="240">
                    <TextBox Style="{StaticResource TidyC.TextBox}"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按路径关键字过滤（仅影响当前视图）" />
                    <TextBlock Text="按路径过滤…" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="12" Foreground="{StaticResource Brush.Text.Disabled}"
                               Visibility="{Binding FilterText, Converter={StaticResource TextVisibility}}" />
                </Grid>
                <Border Style="{StaticResource Pill.Neutral}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding FileCountText, StringFormat=文件 {0}}" FontSize="10.5"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Border>
                <Border Style="{StaticResource Pill.Neutral}" Margin="6,0,0,0">
                    <TextBlock Text="{Binding FolderCountText, StringFormat=目录 {0}}" FontSize="10.5"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Two tables -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Files -->
            <Border Grid.Column="0" Style="{StaticResource TidyC.Container.Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Top 100 巨石文件" Style="{StaticResource Text.H2}" />
                            <Border Style="{StaticResource Pill.Accent}" Margin="10,0,0,0">
                                <TextBlock Text="按分配大小" FontSize="10" Foreground="{StaticResource Brush.Primary.Soft}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TidyC.Container.Inset}" Padding="10,8" Margin="0,0,0,5">
                                        <Grid ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="1.55*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Rank}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                           Foreground="{StaticResource Brush.Text.Primary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Directory}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <controls:ProportionBar Grid.Column="2" Value="{Binding SizeBytes}"
                                                                    Maximum="{Binding MaxBytes}" BarBrush="{Binding BarBrush}"
                                                                    Height="5" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Primary}" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Style="{StaticResource TidyC.Button.Ghost}" Padding="6,2" FontSize="10.5"
                                                        Content="定位"
                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}" />
                                                <Button Style="{StaticResource TidyC.Button.Ghost}" Padding="6,2" FontSize="10.5"
                                                        Content="复制"
                                                        Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Folders -->
            <Border Grid.Column="2" Style="{StaticResource TidyC.Container.Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Top 50 占用目录" Style="{StaticResource Text.H2}" />
                            <Border Style="{StaticResource Pill.Neutral}" Margin="10,0,0,0">
                                <TextBlock Text="含子目录递归" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TidyC.Container.Inset}" Padding="10,8" Margin="0,0,0,5">
                                        <Grid ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Rank}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                           Foreground="{StaticResource Brush.Text.Primary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <controls:ProportionBar Grid.Column="2" Value="{Binding SizeBytes}"
                                                                    Maximum="{Binding MaxBytes}" BarBrush="{Binding BarBrush}"
                                                                    Height="5" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Primary}" />
                                            <Button Grid.Column="4" Style="{StaticResource TidyC.Button.Ghost}" Padding="6,2"
                                                    FontSize="10.5" Content="定位" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource Brush.Surface.ContainerLow}"
                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="14,8">
            <TextBlock Text="大小口径为 NTFS 分配大小（按簇向上取整）· 硬链接按 FRN 去重 · 联接点不会被穿透统计"
                       FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" />
        </Border>
    </Grid>
</UserControl>
