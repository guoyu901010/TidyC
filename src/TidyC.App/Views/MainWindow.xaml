<Window x:Class="TidyC.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="TidyC"
        Icon="pack://application:,,,/Assets/TidyC.ico"
        Width="1440"
        Height="920"
        MinWidth="1180"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Brush.Surface.Base}"
        FontFamily="{StaticResource FontFamily.Default}"
        Foreground="{StaticResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenRulesCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ============================ Title bar ============================ -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Surface.ContainerLowest}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4CC2FF" Offset="0" />
                                <GradientStop Color="#0078D4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource FontFamily.FluentIcon}" FontSize="13"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TidyC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Primary}" Margin="10,0,0,0" />
                    <TextBlock Text="C 盘空间扫描与安全清理" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Tertiary}" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill.Accent}" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="演示数据 · 未访问真实磁盘" FontSize="10.5" Foreground="{StaticResource Brush.Primary.Soft}" />
                    </Border>
                    <Border Style="{StaticResource Pill.Neutral}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Risk.Safe.Light}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EngineText}" FontSize="10.5" Margin="6,0,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource TidyC.Button.Ghost}" Padding="9,5" Margin="0,0,6,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="ElevateButton"
                            AutomationProperties.Name="提权"
                            Command="{Binding ElevateCommand}" ToolTip="以管理员身份重新启动（启用 MFT 直读与特权清理）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource FontFamily.FluentIcon}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="提权" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ======================= Rule set error banner ===================== -->
            <Border Grid.Row="1" Background="#22E81123" BorderBrush="#55E81123" BorderThickness="0,1,0,1"
                    Padding="16,6" Visibility="{Binding HasRuleError, Converter={StaticResource BoolVisibility}}">
                <Grid>
                    <TextBlock Text="{Binding RuleError}" FontSize="11.5" Foreground="#FFB4BB" TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource TidyC.Button.Ghost}" Padding="8,2"
                            Content="查看规则集" Command="{Binding OpenRulesCommand}" />
                </Grid>
            </Border>

            <!-- ============================== Body ============================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Surface.ContainerLowest}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="导航" Style="{StaticResource Text.Label}" Margin="18,18,0,8" />

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource TidyC.List}"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 ItemsSource="{Binding Navigation}"
                                 SelectedValuePath="Key"
                                 SelectedValue="{Binding ActivePage, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Hint}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource FontFamily.FluentIcon}"
                                                   FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0" FontSize="12.5"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="14,10,14,14">
                            <Border Style="{StaticResource TidyC.Container.Inset}" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Primary.Soft}" VerticalAlignment="Center" />
                                        <TextBlock Text="运行状态" Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ElevationText}" FontSize="11" Margin="0,7,0,0"
                                               Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QuarantineRoot}" Style="{StaticResource Text.Mono}" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding QuarantineRoot}" />
                                    <Button Style="{StaticResource TidyC.Button.Ghost}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Padding="8,4" Command="{Binding OpenRulesCommand}" ToolTip="查看内置白名单规则与校验签名">
                                        <TextBlock Text="规则库校验 (F1)" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource TidyC.Button.Ghost}" Margin="0,10,0,0" Padding="8,4"
                                    HorizontalAlignment="Left" Click="OpenDataFolder_Click">
                                <TextBlock Text="打开数据目录" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page host: pages are created once, kept in the tree; switching only changes Z order -->
                <Grid Grid.Column="1" x:Name="PageHost" Background="{StaticResource Brush.Surface.Base}"
                      ClipToBounds="True" />
            </Grid>

            <!-- ============================ Status bar ============================ -->
            <Border Grid.Row="3" Background="{StaticResource Brush.Surface.ContainerLowest}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Risk.Safe.Light}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Primary.Soft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScanStage}" FontSize="11" Margin="12,0,0,0"
                                   Foreground="{StaticResource Brush.Primary.Soft}" VerticalAlignment="Center" />
                        <ProgressBar Style="{StaticResource TidyC.Progress}" Width="180" Margin="16,0,0,0"
                                     Value="{Binding ScanProgress}" Maximum="100"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Text="{Binding ScanDetailText}" FontSize="10.5" Margin="12,0,0,0"
                                   Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TidyC.Button.Danger}" Padding="9,2" Margin="0,0,10,0"
                                FontSize="10.5" Content="取消扫描" Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Text="{Binding VersionText}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Tertiary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== Toast ============================== -->
            <Border Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,24,0"
                    Background="{StaticResource Brush.Surface.ContainerHighest}"
                    BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                    CornerRadius="8" Padding="16,9"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE930;" FontFamily="{StaticResource FontFamily.FluentIcon}" FontSize="12"
                               Foreground="{StaticResource Brush.Primary.Soft}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ToastText}" FontSize="12" Margin="8,0,0,0"
                               Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
