<UserControl x:Class="TidyC.App.Views.ScanRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TidyC.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1180"
             Background="Transparent">
    <Grid Margin="30,20,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="扫描记录 · 谁在长胖" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding GrowthDetail}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding HistoryPath}" Style="{StaticResource Text.Mono}" MaxWidth="340"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding HistoryPath}" VerticalAlignment="Center" />
                <Button Style="{StaticResource TidyC.Button.Secondary}" Margin="10,0,0,0" Command="{Binding RevealHistoryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource FontFamily.FluentIcon}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="打开历史记录" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Latest / previous / growth -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource TidyC.Container.Card}" Padding="16,13">
                <StackPanel>
                    <TextBlock Text="最近一次扫描" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding LatestText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,2"
                               Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding GrowthTitle}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource TidyC.Container.Card}" Padding="16,13">
                <StackPanel>
                    <TextBlock Text="上一次扫描" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding PreviousText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,2"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="差值口径：引擎归因分配字节" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource TidyC.Container.Card}" Padding="16,13"
                    Background="#160078D4" BorderBrush="#330078D4">
                <StackPanel>
                    <TextBlock Text="增量对账（分类）" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Primary.Soft}" />
                    <TextBlock Text="{Binding GrowthTitle}" FontSize="20" FontWeight="Bold" Margin="0,8,0,2"
                               Foreground="{StaticResource Brush.Text.Primary}" />
                    <ItemsControl ItemsSource="{Binding Deltas}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    <TextBlock Text="{Binding DeltaText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                                               Foreground="{Binding Brush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Deltas + WSL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource TidyC.Container.Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="分类增减明细" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="按分类绝对值排序；正值表示长胖，负值表示瘦身" Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,10" />
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Deltas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center" />
                                    <controls:ProportionBar Grid.Column="1" Value="{Binding BarValue}" Maximum="1000"
                                                            BarBrush="{Binding Brush}" Height="6" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaText}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding Brush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource TidyC.Container.Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="WSL2 / Docker 虚拟磁盘压缩" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="{Binding WslStatus}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource TidyC.Button.Ghost}" Padding="8,4" Margin="0,0,6,0"
                                    Content="重新检测" Command="{Binding RescanWslCommand}"
                                    ToolTip="重新枚举 WSL2 / Docker 的 ext4.vhdx" />
                            <Button Style="{StaticResource TidyC.Button.Safe}" Content="压缩虚拟磁盘"
                                    Command="{Binding CompactWslCommand}" IsEnabled="{Binding HasWsl}" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource TidyC.List}"
                             ItemContainerStyle="{StaticResource TidyC.ListItem}"
                             ItemsSource="{Binding WslDisks}" SelectedItem="{Binding SelectedDisk, Mode=TwoWay}"
                             MaxHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary.Soft}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Style="{StaticResource TidyC.Separator}" Margin="0,10,0,10" />

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="只通过系统工具压缩（wsl --shutdown → Optimize-VHD / diskpart compact），绝不手删 vhdx。"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource Brush.Surface.ContainerLowest}">
                            <TextBlock Text="{Binding WslOutput}" Style="{StaticResource Text.Mono}" FontSize="10.5"
                                       Margin="10,8" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- History table -->
        <Border Grid.Row="3" Style="{StaticResource TidyC.Container.Card}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="历史扫描摘要（保留最近 24 次）" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{Binding GrowthDetail}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" /><ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="引擎" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="2" Text="归因大小" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="3" Text="文件数" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="4" Text="耗时" Style="{StaticResource Text.Label}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="118" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" /><ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DateText}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding EngineText}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.Text.Tertiary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FilesText}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.Text.Tertiary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
